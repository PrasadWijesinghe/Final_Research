# GitHub token for API access
GITHUB_TOKEN=

# Salt for hashing author and reviewer identities
IDENTITY_SALT=

# Team member name (dependency | build | test | infra)
MEMBER=test

# PostgreSQL credentials
POSTGRES_USER=pipelineiq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pipelineiq

# DEFAULT: PostgreSQL port (from P0.4 Docker Compose configuration)
POSTGRES_PORT=5432

# DEFAULT: Database connection URL (from P0.4 Docker Compose configuration)
# DEFAULT: 127.0.0.1 not localhost, because localhost is very slow on Windows (IPv6 tried first)
DATABASE_URL=postgresql+psycopg://pipelineiq:change-me@127.0.0.1:5432/pipelineiq

# DEFAULT: Redis port (from P0.4 Docker Compose configuration)
REDIS_PORT=6379

# Redis connection URL
REDIS_URL=redis://127.0.0.1:6379/0

# LLM provider (mock | openai | anthropic | etc)
LLM_PROVIDER=mock

# API key for the LLM provider
LLM_API_KEY=

# DEFAULT: Backend URL where experts post diagnoses (empty = stubs just return them)
BACKEND_URL=

# DEFAULT: GitHub client sleeps until the rate-limit reset when fewer than this many calls remain
GITHUB_RATE_LIMIT_THRESHOLD=200

# DEFAULT: smallest date window (hours) the client splits down to when a query hits the 1,000 cap
GITHUB_MIN_WINDOW_HOURS=1

# Optional: override the location of config/sanitise_patterns.yaml
# SANITISE_PATTERNS_FILE=

# DEFAULT: where the collector writes sanitised logs and file blobs (empty = <checkout>/data)
DATA_DIR=

# DEFAULT: port an expert's API listens on (dependency 8101, build 8102, test 8103, infra 8104)
EXPERT_PORT=8101

# DEFAULT: seconds a worker waits for the backend when posting a diagnosis
BACKEND_TIMEOUT_SECONDS=10

# DEFAULT: port the LLM gateway listens on (internal only)
LLM_GATEWAY_PORT=8200

# DEFAULT: URL experts use to reach the LLM gateway
LLM_GATEWAY_URL=http://127.0.0.1:8200

# Optional: override the location of config/llm.yaml
# LLM_CONFIG_FILE=

# Embeddings (optional extra: uv sync --all-packages --extra embeddings)
# DEFAULT: granite small, 384-d; set EMBEDDING_PROVIDER=fake to use the offline fake embedder
EMBEDDING_MODEL=ibm-granite/granite-embedding-small-english-r2
# Optional: folder where sentence-transformers caches the model
# EMBEDDING_CACHE_DIR=
# EMBEDDING_PROVIDER=granite
