# GitHub token for API access
GITHUB_TOKEN=

# Salt for hashing author and reviewer identities
IDENTITY_SALT=

# Team member name (dependency | build | test | infra)
MEMBER=test

# PostgreSQL credentials
POSTGRES_USER=pipelineiq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pipelineiq

# DEFAULT: PostgreSQL port (from P0.4 Docker Compose configuration)
POSTGRES_PORT=5432

# DEFAULT: Database connection URL (from P0.4 Docker Compose configuration)
# DEFAULT: 127.0.0.1 not localhost, because localhost is very slow on Windows (IPv6 tried first)
DATABASE_URL=postgresql+psycopg://pipelineiq:change-me@127.0.0.1:5432/pipelineiq

# DEFAULT: Redis port (from P0.4 Docker Compose configuration)
REDIS_PORT=6379

# Redis connection URL
REDIS_URL=redis://127.0.0.1:6379/0

# LLM provider: mock (placeholder answers, no network) or deepseek (real model, costs money)
LLM_PROVIDER=mock

# API key for the LLM provider (needed for deepseek; never commit it)
LLM_API_KEY=

# Optional: override the provider's base URL (empty = https://api.deepseek.com for deepseek)
LLM_BASE_URL=

# Optional: override the model (empty = the provider's default from config/llm.yaml)
# LLM_MODEL=

# DEFAULT: Backend URL where experts post diagnoses (empty = stubs just return them)
BACKEND_URL=

# DEFAULT: GitHub client sleeps until the rate-limit reset when fewer than this many calls remain
GITHUB_RATE_LIMIT_THRESHOLD=200

# DEFAULT: smallest date window (hours) the client splits down to when a query hits the 1,000 cap
GITHUB_MIN_WINDOW_HOURS=1

# Optional: override the location of config/sanitise_patterns.yaml
# SANITISE_PATTERNS_FILE=

# DEFAULT: where the collector writes sanitised logs and file blobs (empty = <checkout>/data)
DATA_DIR=

# DEFAULT: port an expert's API listens on (dependency 8101, build 8102, test 8103, infra 8104)
EXPERT_PORT=8101

# DEFAULT: seconds a worker waits for the backend when posting a diagnosis
BACKEND_TIMEOUT_SECONDS=10

# DEFAULT: port the LLM gateway listens on (internal only)
LLM_GATEWAY_PORT=8200

# DEFAULT: URL experts use to reach the LLM gateway
LLM_GATEWAY_URL=http://127.0.0.1:8200

# Optional: override the location of config/llm.yaml
# LLM_CONFIG_FILE=

# Build expert (experts/build)
# Model bundle served by POST /predict (models/build/<version>); unset = the stub answers
# BUILD_MODEL_DIR=
# DEFAULT: off; "on" lets the diagnosis worker rewrite its text through the LLM gateway
# BUILD_LLM=off

# Embeddings (optional extra: uv sync --all-packages --extra embeddings)
# DEFAULT: granite small, 384-d; set EMBEDDING_PROVIDER=fake to use the offline fake embedder
EMBEDDING_MODEL=ibm-granite/granite-embedding-small-english-r2
# Optional: folder where sentence-transformers caches the model
# EMBEDDING_CACHE_DIR=
# EMBEDDING_PROVIDER=granite

# Backend API (services/api)
# DEFAULT: port the backend listens on
API_PORT=8000
# DEFAULT: expert URLs for local runs (compose overrides with service names)
EXPERT_DEPENDENCY_URL=http://127.0.0.1:8101
EXPERT_BUILD_URL=http://127.0.0.1:8102
EXPERT_TEST_URL=http://127.0.0.1:8103
EXPERT_INFRA_URL=http://127.0.0.1:8104
# DEFAULT: total budget for a pre-push /predict (10 s) and for PR notes (2 min), in milliseconds
PREDICT_BUDGET_PRE_PUSH_MS=10000
PREDICT_BUDGET_PR_MS=120000
# DEFAULT: seconds for expert /health probes and /review forwarding
EXPERT_CALL_TIMEOUT_SECONDS=2
# Secret that protects POST/DELETE /api-keys until GitHub sign-in exists (empty = key management off)
API_ADMIN_TOKEN=
# DEFAULT: router rules file; unset = config/router_rules.yaml
# ROUTER_RULES_PATH=

# Replay CLI (uv run replay --member test --from YYYY-MM-DD --to YYYY-MM-DD)
# Reads logs from DATA_DIR (above), the database from DATABASE_URL, experts from EXPERT_*_URL,
# and queues failures on REDIS_URL. It never calls GitHub, so it needs no GITHUB_TOKEN.

# End-to-end test (make e2e; services/api/tests/e2e)
# DEFAULT: where the e2e test finds the backend API from the host; the test skips when unreachable
# E2E_API_URL=http://127.0.0.1:8000
# DEFAULT: 1 = fail instead of skip when the stack is down (make e2e sets it; leave unset locally)
# E2E_REQUIRED=
# Test worker in Compose (P4.12). Backend it posts diagnoses to; unset = http://host.docker.internal:8000
# (the API on your machine); `make e2e` sets http://api:8000; an empty value posts nowhere.
# EXPERT_BACKEND_URL=
# Gateway the Test worker calls; unset = the compose llm-gateway service; empty = template text only.
# EXPERT_LLM_GATEWAY_URL=

# GitHub App (P3.1; guide in docs/GITHUB_APP.md). Placeholders only; real values live in .env.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Dashboard sign-in (P3.5). SESSION_SECRET: long random string (openssl rand -hex 32); empty = sign-in answers 503
SESSION_SECRET=
# DEFAULT: public base URL of the API, used for the OAuth callback (must match the App's callback URL)
API_PUBLIC_URL=http://localhost:8000
# DEFAULT: where the browser lands after sign-in
DASHBOARD_URL=http://localhost:5173
# DEFAULT: set false for plain-http localhost; keep true behind https
SESSION_COOKIE_SECURE=false
# Seconds between check-run retries (P3.3), comma separated; empty = 30,90,300,900
CHECK_RETRY_DELAYS_SECONDS=
# DEFAULT: keep the .pem outside the repo, e.g. ~/.pipelineiq/github-app.pem (chmod 600)
GITHUB_APP_PRIVATE_KEY_PATH=
# Webhook secret you typed when registering the App (empty = /webhooks/github answers 503)
GITHUB_WEBHOOK_SECRET=
# smee.io channel URL used as the App's webhook URL (P3.2, `make webhooks`)
SMEE_URL=
